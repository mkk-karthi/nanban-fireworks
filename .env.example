# ==============================================================================
# Nanban Crackers - Environment Variables (Cloudflare Pages & Local Development)
# ==============================================================================
# Since this project is deployed on Cloudflare Pages using Next.js static export
# (output: "export"), all environment variables accessed in the browser MUST start
# with the NEXT_PUBLIC_ prefix.
#
# Setup these in Cloudflare Dashboard:
# Workers & Pages > [Project] > Settings > Environment variables > Add variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Service ID: Found in EmailJS Dashboard > Email Services (e.g. service_xxxxxxx)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_nanban

# 2. Admin Template ID: Found in EmailJS Dashboard > Email Templates (e.g. template_xxxxxxx)
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_admin_order

# 3. Public Key: Found in EmailJS Dashboard > Account > Public Key (e.g. user_xxxxxxx / xxxxxxxxxx)
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# ------------------------------------------------------------------------------
# Cloudflare Turnstile CAPTCHA (Free, privacy-first bot protection)
# ------------------------------------------------------------------------------
# Site Key: Found in Cloudflare Dashboard > Turnstile > [Your Site] > Site Key
# For local testing, you can use Cloudflare's dummy test key that always passes:
# 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAyour_site_key
